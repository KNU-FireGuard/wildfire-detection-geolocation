FROM node:22-bookworm-slim AS build
WORKDIR /frontend
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ ./
COPY deploy/mock-cameras.js ./src/mocks/cameras.js
COPY deploy/mock-events.js ./src/mocks/events.js
ARG VITE_NAVER_MAP_CLIENT_ID
ARG VITE_DEMO_MODE=false
ENV VITE_DATA_SOURCE=api VITE_NAVER_MAP_CLIENT_ID=${VITE_NAVER_MAP_CLIENT_ID} VITE_DEMO_MODE=${VITE_DEMO_MODE}
RUN npm run build
FROM nginx:stable-alpine
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /frontend/dist /usr/share/nginx/html
EXPOSE 80
