FROM node:22-bookworm-slim AS node
FROM python:3.11-slim-bookworm
COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/npm
RUN ln -s /usr/local/lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
    && apt-get update && apt-get install -y --no-install-recommends libgl1 libglib2.0-0 ca-certificates \
    && rm -rf /var/lib/apt/lists/*
ARG TORCH_INDEX_URL=https://download.pytorch.org/whl/cu118
RUN pip install --no-cache-dir torch==2.7.1 torchvision==0.22.1 --index-url ${TORCH_INDEX_URL}
COPY deploy/requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt
WORKDIR /app/backend
COPY backend/package.json backend/package-lock.json ./
RUN npm ci --omit=dev
COPY backend/src ./src
COPY ai/camera_config.py ai/camera_model.py ai/camera_calibration.py ai/dem_skyline_engine.py ai/fire_location_estimator.py ai/location_session.py ai/ridge_detector.py /app/ai/
COPY ai/inference/*.py /app/ai/inference/
COPY deploy/cameras.json /app/ai/config/cameras.json
RUN mkdir -p /app/data/ultralytics/Ultralytics /app/ai/.dem_cache /app/ai/.skyline_cache /app/ai/.location_cache /models \
    && groupadd --gid 10001 fireguard && useradd --uid 10001 --gid 10001 --create-home fireguard \
    && chown -R fireguard:fireguard /app /models
ENV NODE_ENV=production HOST=0.0.0.0 PORT=3000 PYTHON_EXECUTABLE=/usr/local/bin/python HOME=/home/fireguard \
    PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 YOLO_CONFIG_DIR=/app/data/ultralytics
USER fireguard
EXPOSE 3000
CMD ["node", "src/server.js"]
