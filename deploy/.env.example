# Copy to deploy/.env (ignored by Git), never include real secrets in images
DB_NAME=fireguard
DB_USER=fireguard
DB_PASSWORD=
JWT_SECRET=
AI_CALLBACK_TOKEN=
ADMIN_USERNAME=admin
ADMIN_INITIAL_PASSWORD=
ITS_CCTV_API_KEY=
VITE_NAVER_MAP_CLIENT_ID=
# Absolute path to the existing model file on the execution machine
MODEL_FILE=
# Company-approved port; bind address must be approved before external exposure
WEB_PORT=
WEB_BIND_IP=127.0.0.1
GPU_DEVICE_ID=0
IMAGE_TAG=local
# No actual SMS until explicitly configured
SMS_PROVIDER=console
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SOLAPI_SENDER=
# Mac demo override only
DEMO_VIDEO_DIR=
