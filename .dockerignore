# Allowlist: build context excludes videos, model weights, secrets, seed SQL and caches
**
!backend/
backend/*
!backend/package.json
!backend/package-lock.json
!backend/src/
!backend/src/**
!frontend/
frontend/*
!frontend/package.json
!frontend/package-lock.json
!frontend/index.html
!frontend/vite.config.js
!frontend/src/
!frontend/src/**
frontend/src/mocks/**
!frontend/public/
!frontend/public/**
!ai/
ai/*
!ai/camera_config.py
!ai/camera_model.py
!ai/camera_calibration.py
!ai/dem_skyline_engine.py
!ai/fire_location_estimator.py
!ai/location_session.py
!ai/ridge_detector.py
!ai/inference/
!ai/inference/*.py
!deploy/
deploy/*
!deploy/Dockerfile.api
!deploy/Dockerfile.web
!deploy/requirements.txt
!deploy/nginx.conf
!deploy/cameras.json
!deploy/mock-cameras.js
!deploy/mock-events.js
**/.DS_Store
**/.env
**/.env.*
**/*.pem
**/*.key
**/*.mp4
**/*.pt
**/*.npz
**/node_modules
**/__pycache__
