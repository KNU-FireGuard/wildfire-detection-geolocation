PORT=3000
DB_HOST=localhost
DB_PORT=5432
DB_NAME=fireguard
DB_USER=fireguard
DB_PASSWORD=
ADMIN_USERNAME=admin
ADMIN_INITIAL_PASSWORD=
JWT_SECRET=
AI_CALLBACK_TOKEN=
ITS_CCTV_API_KEY=
# AI 담당자가 실시간 감시 작업자를 제공하면 저장소 루트 기준 경로 입력
AI_LIVE_RUNNER_PATH=
# 화재 탐지 문자 발송 제공자: console(기본, 로그만 출력) 또는 solapi(실제 발송)
SMS_PROVIDER=console
# SMS_PROVIDER=solapi일 때 필요, 키는 Frontend나 Git에 넣지 않음
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
# 솔라피에 등록된 발신번호, 하이픈 없이 입력, 가입 본인인증 휴대전화 번호는 자동 등록됨
SOLAPI_SENDER=
